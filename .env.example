APP_NAME="PetFlow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# URL pública del SPA (emails de reset / enlaces). En producción del VPS:
# FRONTEND_URL=https://tu-frontend.dominio.com
FRONTEND_URL=

# En VPS de producción DEBE ser:
# APP_ENV=production
# APP_DEBUG=false
# (El deploy falla si no, salvo ALLOW_INSECURE_ENV=true)
# ALLOW_INSECURE_ENV=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_api_sunat
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MAIL — desarrollo: log | producción: smtp
# En desarrollo los correos van a storage/logs (MAIL_MAILER=log).
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Ejemplo Hostinger (producción, editar solo en .env del VPS; NUNCA en git) ---
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=noreply@tudominio.com
# MAIL_PASSWORD=********
# MAIL_FROM_ADDRESS="noreply@tudominio.com"
# MAIL_FROM_NAME="PetFlow"
# Alternativa puerto 587:
# MAIL_SCHEME=null
# MAIL_PORT=587
# (y en algunos paneles: cifrado STARTTLS)
#
# Probar en el VPS tras configurar:
#   php artisan mail:test tu-correo@ejemplo.com
#   php artisan config:cache

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum Configuration para desarrollo  
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
SANCTUM_EXPIRATION=1440
SANCTUM_TOKEN_PREFIX=sunat_beta_
SANCTUM_VERIFY_IP=false
SANCTUM_LOG_USAGE=true
SANCTUM_MAX_INACTIVITY=120
SANCTUM_MAX_TOKENS=10
SANCTUM_ROTATE_TOKENS=false
SANCTUM_PURGE_DAYS=7

# SUNAT Configuration - BETA Environment
SUNAT_ENVIRONMENT=beta
SUNAT_CERTIFICATE_PATH=
SUNAT_CERTIFICATE_PASSWORD=
SUNAT_PRIVATE_KEY_PATH=

# Files Configuration
FILES_STORAGE_PATH=storage/app/sunat
FILES_MAX_SIZE=10240

# Empresa usada por el portal/booking público (hasta multi-tenant)
# SMARTPET_PUBLIC_COMPANY_ID=1

VITE_APP_NAME="${APP_NAME}"
